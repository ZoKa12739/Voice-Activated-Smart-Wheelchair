# =========================
# Project ignore rules
# Goal: commit only source and required configs
# =========================

# --- OS / editor temp files ---
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.temp
*.bak
*.log

# --- VS Code / IDE local settings ---
.vscode/
**/.settings/
**/*.launch
**/.browse
**/*.sdf
**/*.su
**/*.cyclo

# --- STM32 / generic embedded build outputs ---
**/Debug/
**/Release/
**/obj/
**/bin/
*.o
*.d
*.a
*.map
*.elf
*.hex
*.bin

# --- Keil MDK project temp files ---
*.uvguix.*
*.uvoptx
*.dep
*.lst
*.m51
*.htm
*.lnp
*.sct
*.i
*.crf
*.axf

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.env
.env.*
venv/
.venv/
env/
build/
dist/
*.spec

# --- Qt / QMake build outputs ---
*.qmake.stash
*.pro.user
moc_*.cpp
moc_*.o
ui_*.h
*.so
*.dll
*.exe

# --- Large third-party deps and local binaries ---
raspberry/opencv-4.8.0/
raspberry/Pi_opencv/OpenCV_CameraMonitor
